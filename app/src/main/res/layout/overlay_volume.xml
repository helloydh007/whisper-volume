<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_pill"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:minWidth="272dp"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/overlay_minus"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_overlay_button"
        android:clickable="true"
        android:contentDescription="@string/overlay_lower_desc"
        android:focusable="true"
        android:gravity="center"
        android:text="−"
        android:textColor="@color/overlay_text"
        android:textSize="25sp" />

    <LinearLayout
        android:id="@+id/overlay_drag_handle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/overlay_db"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="−24.0 dB"
            android:textColor="@color/overlay_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/overlay_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:text="@string/overlay_caption"
            android:textColor="@color/overlay_muted"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlay_plus"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_overlay_button"
        android:clickable="true"
        android:contentDescription="@string/overlay_raise_desc"
        android:focusable="true"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/overlay_text"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/overlay_close"
        android:layout_width="34dp"
        android:layout_height="44dp"
        android:clickable="true"
        android:contentDescription="@string/overlay_close"
        android:focusable="true"
        android:gravity="center"
        android:text="×"
        android:textColor="@color/overlay_muted"
        android:textSize="18sp" />

</LinearLayout>
